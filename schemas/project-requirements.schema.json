{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectRequirements",
  "type": "object",
  "required": ["project_id", "requirements"],
  "properties": {
    "project_id": { "type": "string", "pattern": "^PROJECT-[0-9]{3,}$" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "justification", "priority", "origin", "dependencies", "acceptance_criteria", "status", "certainty"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]{4}$" },
          "description": { "type": "string", "minLength": 1 },
          "justification": { "type": "string" },
          "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "origin": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "status": { "type": "string", "enum": ["draft", "confirmed", "approved", "rejected"] },
          "certainty": { "type": "string", "enum": ["confirmed", "assumption", "recommendation", "open_question"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}