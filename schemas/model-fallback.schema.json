{"$schema": "http://json-schema.org/draft-07/schema#", "title": "ModelFallbackLog", "type": "object", "required": ["log_id", "agent_id", "primary_model", "effective_model", "provider", "status", "created_at"], "properties": {"log_id": {"type": "string"}, "execution_id": {"type": ["string", "null"]}, "task_id": {"type": ["string", "null"]}, "agent_id": {"type": "string", "pattern": "^ag-\\d{3}"}, "primary_model": {"type": "string"}, "effective_model": {"type": "string"}, "fallback_model": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"], "enum": [null, "quota_exhausted", "rate_limit", "transient", "auth", "ambiguous"]}, "provider": {"type": "string", "const": "opencode-go"}, "started_at": {"type": ["string", "null"], "format": "date-time"}, "wait_seconds": {"type": "number", "minimum": 0}, "retries": {"type": "integer", "minimum": 0}, "status": {"type": "string", "enum": ["RUNNING", "WAITING_RATE_LIMIT", "WAITING_QUOTA_RESET", "FALLBACK_ACTIVE", "COMPLETED", "FAILED", "NEEDS_INTERVENTION"]}, "error_message": {"type": ["string", "null"]}, "created_at": {"type": "string", "format": "date-time"}}}