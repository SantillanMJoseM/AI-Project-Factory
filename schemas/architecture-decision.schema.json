{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArchitectureDecision",
  "type": "object",
  "required": ["id", "context", "problem", "alternatives", "decision", "justification", "consequences", "risks", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^ADR-F2-[0-9]{4}$" },
    "context": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "alternatives": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "justification": { "type": "string", "minLength": 1 },
    "consequences": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["proposed", "accepted", "rejected", "superseded"] }
  },
  "additionalProperties": false
}