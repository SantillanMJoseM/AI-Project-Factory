{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestPlan",
  "type": "object",
  "required": ["plan_id","project_id","version","commit","scope","test_types","created_by"],
  "properties": {
    "plan_id": { "type": "string", "pattern": "^TPLAN-[0-9]{4}$" },
    "project_id": { "type": "string", "pattern": "^PROJECT-[0-9]{3,}$" },
    "version": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "test_types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_by": { "type": "string", "pattern": "^AG-[0-9]{3}$" }
  },
  "additionalProperties": false
}