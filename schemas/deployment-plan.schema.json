{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeploymentPlan",
  "type": "object",
  "required": [
    "deployment_id",
    "project_id",
    "version",
    "commit",
    "artifact",
    "environment",
    "strategy",
    "rollback_plan",
    "created_by"
  ],
  "properties": {
    "deployment_id": {
      "type": "string",
      "pattern": "^DEP-[0-9]{4}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PROJECT-[0-9]{3,}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "type": "string",
      "enum": [
        "rolling",
        "blue_green",
        "canary",
        "in_place",
        "traditional",
        "manual"
      ]
    },
    "rollback_plan": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "string",
      "pattern": "^AG-[0-9]{3}$"
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "artifact_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
