{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestExecution",
  "type": "object",
  "required": ["execution_id","plan_id","commit","framework","environment","total","passed","failed","skipped","evidence","duration_seconds"],
  "properties": {
    "execution_id": { "type": "string", "pattern": "^TEXEC-[0-9]{4}$" },
    "plan_id": { "type": "string", "pattern": "^TPLAN-[0-9]{4}$" },
    "commit": { "type": "string", "minLength": 1 },
    "framework": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "total": { "type": "integer" },
    "passed": { "type": "integer" },
    "failed": { "type": "integer" },
    "skipped": { "type": "integer" },
    "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "duration_seconds": { "type": "number" }
  },
  "additionalProperties": false
}