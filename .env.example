# AI-Project-Factory environment configuration (BEAM_FREE_ONLY)
# Copy to .env and fill in values. Do not commit .env.

# OpenCode provider (BEAM_FREE_ONLY)
OPENCODE_API_KEY=your-opencode-api-key

# Runtime
APF_DB_PATH=orchestration/runtime/runtime.db
APF_LOG_LEVEL=info
OPENCODE_BIN=opencode

# Do not set OPENAI_API_KEY, ANTHROPIC_API_KEY, or other provider keys.
# Model policy: BEAM_FREE_ONLY (opencode-go/beam-free) [default].
# To enable multi-model routing: APF_MODEL_POLICY=MODEL_ROUTING_V2
# Rollback: unset or set APF_MODEL_POLICY=BEAM_FREE_ONLY.